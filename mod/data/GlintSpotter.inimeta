// INI Master metadata for GlintSpotter.ini, embedded in GlintSpotter.asi as the
// INIMETA resource (see src/resources.rc). Keep it in step with settings.cpp;
// scripts/check_inimeta.py compares the two and release.json's gates refuse a
// build when they disagree.
{
  "inimeta": 1,
  "name": "Glint Spotter",
  "author": "Seth",
  "url": "https://www.nexusmods.com/crimsondesert/mods/3472",
  "ini": "GlintSpotter.ini",
  "live": false,
  "description": "Puts a map marker on whatever you are looking at, either through the Blinding Flash skill or a key. The ini is only read once, at startup; a change needs a restart.",
  "sections": {
    "GlintSpotter": {
      "label": "Glint Spotter",
      "order": 1,
      "keys": {
        "Chord": {
          "label": "Controller mark chord",
          "type": "string",
          "group": "Marking",
          "default": "RB+LB+A",
          "help": [
            "Controller buttons held together to mark whatever the crosshair is on.",
            "Names: A B X Y LB RB LS RS UP DOWN LEFT RIGHT BACK START, joined with + or a comma.",
            "On a PlayStation pad LB is L1, RB is R1, A is Cross, B is Circle, X is Square, Y is Triangle, BACK is Share or Create and START is Options."
          ],
          "order": 1
        },
        "Hold": {
          "label": "Chord hold time",
          "type": "int",
          "group": "Marking",
          "default": "0",
          "min": 0,
          "max": 5000,
          "unit": "ms",
          "help": [
            "Milliseconds the controller chord must be held before it fires. Zero fires at once.",
            "Raise it if a mark ever lands during a fight."
          ],
          "order": 2
        },
        "Key": {
          "label": "Mark key",
          "type": "key",
          "format": "name",
          "group": "Marking",
          "default": "F9",
          "help": [
            "The key that marks whatever the crosshair is on.",
            "A name: F1 to F24, a letter, a digit, Insert, Delete, Home, End, PageUp, PageDown, Pause, ScrollLock, Numpad0 to Numpad9. F9 because the game binds nothing to it."
          ],
          "order": 3
        },
        "Rumble": {
          "label": "Buzz the pad on a pin",
          "type": "bool",
          "true": "1",
          "false": "0",
          "group": "Marking",
          "default": "1",
          "help": "Buzzes the controller when a pin lands. The map is rarely open at that moment, so this is usually the only thing that tells you it worked.",
          "order": 4
        },
        "DirectPad": {
          "label": "Read PlayStation pads directly",
          "type": "bool",
          "true": "1",
          "false": "0",
          "group": "Marking",
          "default": "1",
          "help": [
            "Reads a DualSense or DualShock 4 directly, so the chord and the buzz work without Steam Input, and the game keeps its PlayStation button pictures.",
            "Off leaves those pads to Steam Input or DS4Windows. Xbox pads are unaffected."
          ],
          "order": 5
        },
        "RealMarkers": {
          "label": "Pins are removable map markers",
          "type": "bool",
          "true": "1",
          "false": "0",
          "group": "Marking",
          "default": "1",
          "help": [
            "Makes each pin a marker the map can remove: put the cursor on it and the map offers Remove Marker, the same as for one you placed yourself.",
            "Off draws pins the old way and nothing removes them."
          ],
          "order": 6
        },
        "KeepPins": {
          "label": "Keep pins across saves",
          "type": "bool",
          "true": "1",
          "false": "0",
          "group": "Marking",
          "default": "1",
          "help": [
            "Keeps your pins in GlintSpotter.pins beside the plugin and puts them back when you load a save, since the game itself clears them.",
            "Pins are kept per save: the mod watches which save file the game opens, so another character has its own pins.",
            "The file is plain text, one group per save. Delete a group to clear one save's pins, or the file to clear all of them."
          ],
          "order": 7
        },
        "ClearTaken": {
          "label": "Clear pins once taken",
          "type": "bool",
          "true": "1",
          "false": "0",
          "group": "Marking",
          "default": "1",
          "help": [
            "Takes an automatic Glint pin off the map once the thing it marked has been picked up or finished.",
            "Off leaves it there until you remove it."
          ],
          "order": 8
        },
        "ClearNear": {
          "label": "Clear pins once close",
          "type": "float",
          "group": "Marking",
          "default": "10.0",
          "min": 0.0,
          "max": 1000.0,
          "unit": "m",
          "help": [
            "A pin you place with the key or the pad chord comes off once you walk within this many metres of it.",
            "One you place close by stays until you have walked away from it and come back. 0 leaves them there until you remove them."
          ],
          "order": 9
        },
        "Teleporters": {
          "label": "Mark unlocked teleporters",
          "type": "bool",
          "true": "1",
          "false": "0",
          "group": "Marking",
          "default": "1",
          "help": [
            "Lets the flash mark teleporters, the abyss ruins, whatever the Kinds line says.",
            "One you have already switched on is left alone. Off leaves them to Kinds."
          ],
          "order": 10
        },
        "PinStyle": {
          "label": "Pin marker picture",
          "type": "string",
          "group": "Marking",
          "default": "1,4",
          "help": [
            "Which of the map's marker pictures a pin uses, as two numbers separated by a comma.",
            "1,4 is the one on the Change Marker list; 4,14 is the plain marker you get by default.",
            "The first is 0 to 13 and the second 0 to 14. To find another, place one by hand with Change Marker and read the style pair out of the log."
          ],
          "order": 11
        },
        "Mark": {
          "label": "Node names worth a pin",
          "type": "string",
          "group": "Marking",
          "default": "clue,artifact,treasure,relic,chest,challenge,standstone,socket_collection,gather,ore,herb,flower,mushroom,useartifact,puzzle_attach,dial,crank,lever",
          "help": [
            "Comma list of node name fragments, matched anywhere in the prefab path, that count as worth marking.",
            "Names come from the node's own prefab path, e.g. gimmick_item_graymane_clue_01 is matched by clue."
          ],
          "order": 26
        },
        "Rod": {
          "label": "Press aim width",
          "type": "float",
          "group": "Aiming",
          "default": "8.0",
          "min": 0.05,
          "max": 60.0,
          "unit": "m",
          "help": [
            "How far either side of the sight line a press looks, in metres, the same at every distance.",
            "Larger finds more and is wrong more often. If a press misses something, the log prints how far off the line it was, which is the number to put here."
          ],
          "order": 12
        },
        "PressReach": {
          "label": "Press aim distance",
          "type": "float",
          "group": "Aiming",
          "default": "0.0",
          "min": 0.0,
          "max": 20000.0,
          "unit": "m",
          "help": [
            "How far out a press will look, in metres. Zero means no limit.",
            "A nonzero value below 50 is rejected and the previous number is kept."
          ],
          "order": 13
        },
        "AutoCone": {
          "label": "Automatic marker cone",
          "type": "float",
          "group": "Aiming",
          "default": "2.0",
          "min": 0.05,
          "max": 45.0,
          "unit": "deg",
          "help": [
            "The automatic marker's cone, in degrees, used during Blinding Flash.",
            "Wider than a press on purpose: nobody aims carefully during a flash, and a miss there is a glint lost."
          ],
          "order": 14
        },
        "Reach": {
          "label": "Level gimmick distance ceiling",
          "type": "float",
          "group": "Aiming",
          "default": "1500.0",
          "min": 0.0,
          "max": 20000.0,
          "unit": "m",
          "help": [
            "A ceiling in metres on how far out the automatic marker will reach.",
            "Zero means none, which once put a pin three kilometres away.",
            "A nonzero value below 50 is rejected and the previous number is kept."
          ],
          "order": 15
        },
        "Kinds": {
          "label": "Level gimmick names worth a pin",
          "type": "string",
          "group": "Aiming",
          "default": "vein_,challenge,mission,artifact,treasure,relic,clue,visione,titan,puzzle,standstone,socket",
          "help": [
            "Comma list of name fragments a level gimmick must match to earn a pin, case insensitive.",
            "Empty accepts anything that is not a bare level chunk. Widen it if Blinding Flash finds things it will not mark, narrow it if it marks things you do not want."
          ],
          "order": 16
        },
        "Scan": {
          "label": "Walk the heap for the player's component",
          "type": "bool",
          "true": "1",
          "false": "0",
          "group": "Startup",
          "default": "1",
          "help": [
            "Whether to walk the heap looking for the player's own component at startup.",
            "Can freeze the game for a second or two, once per launch, but is the only route that has ever found this component."
          ],
          "order": 17
        },
        "Spy": {
          "label": "Watch the map for its own icons",
          "type": "bool",
          "true": "1",
          "false": "0",
          "group": "Diagnostics",
          "default": "1",
          "help": "Logs every map icon the game creates. The mod also needs this to find the map itself, so turning it off turns off marking.",
          "order": 18
        },
        "Verbose": {
          "label": "Verbose investigation logging",
          "type": "bool",
          "true": "1",
          "false": "0",
          "group": "Diagnostics",
          "default": "0",
          "advanced": true,
          "help": [
            "Turns on the investigation output: the whole gimmick table as it loads, the string catalogue, the nearby entity listing, a per-field probe.",
            "About a thousand log lines a minute and it stutters the frame. For bug reports only."
          ],
          "order": 19
        },
        "MiniPin": {
          "label": "Copy pins to the minimap",
          "type": "bool",
          "true": "1",
          "false": "0",
          "group": "Diagnostics",
          "default": "0",
          "advanced": true,
          "help": "Also copies each pin onto the minimap. Crashed the game in an earlier session; leave it off.",
          "order": 20
        },
        "RayFallback": {
          "label": "Guess a press from terrain",
          "type": "bool",
          "true": "1",
          "false": "0",
          "group": "Diagnostics",
          "default": "0",
          "advanced": true,
          "help": "Lets a press that the level gimmick table cannot answer guess a spot from terrain past where the game has any. The guess is an extrapolation, not a real find. Off.",
          "order": 21
        },
        "Sweep": {
          "label": "Sweep the heap for live objects",
          "type": "bool",
          "true": "1",
          "false": "0",
          "group": "Diagnostics",
          "default": "0",
          "advanced": true,
          "help": "Hunts for live objects by scanning the heap. Slow and no longer needed; it is what stalls the game a few seconds after launch. Off.",
          "order": 22
        },
        "Guess": {
          "label": "Guess a target when nothing is marked",
          "type": "bool",
          "true": "1",
          "false": "0",
          "group": "Diagnostics",
          "default": "0",
          "advanced": true,
          "help": [
            "Pin the node nearest the crosshair when the game has not marked anything.",
            "Off: only what the game marks is pinned."
          ],
          "order": 23
        },
        "Survey": {
          "label": "Survey every candidate on a press",
          "type": "bool",
          "true": "1",
          "false": "0",
          "group": "Diagnostics",
          "default": "0",
          "advanced": true,
          "help": [
            "One press at each place pins every candidate the old actor search found, labelled by distance.",
            "A diagnostic from before the level gimmick table. Set back to 0 once you are done."
          ],
          "order": 24
        },
        "Radius": {
          "label": "Entity search radius",
          "type": "float",
          "group": "Diagnostics",
          "default": "0.0",
          "min": 0.0,
          "max": 2000.0,
          "unit": "m",
          "advanced": true,
          "help": [
            "Unused unless Guess is on: a cap in metres on the old nearby-object search.",
            "Zero means everything the game has loaded, which is already a few hundred metres and no more.",
            "A nonzero value below 5 is rejected and the previous number is kept."
          ],
          "order": 25
        },
        "Watch": {
          "label": "Diagnostic watch",
          "type": "enum",
          "options": [
            { "value": "0", "label": "Off" },
            { "value": "1", "label": "Flash flag" },
            { "value": "2", "label": "Save list counts" }
          ],
          "group": "Diagnostics",
          "default": "0",
          "advanced": true,
          "help": "1 watches the Blinding Flash flag, 2 watches the save list counts. 0 is off.",
          "order": 27
        }
      }
    }
  }
}
